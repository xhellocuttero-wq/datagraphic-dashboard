<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DATA GRAPHIC | FIXED & OPTIMIZED</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Sarabun:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', 'Sarabun', sans-serif; background-color: #fdfcfb; }
        .nav-active { color: #fb923c; background: #fff7ed; font-weight: 600; box-shadow: inset 4px 0 0 #fb923c; }
        .card { background: white; border-radius: 1rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        th { font-size: 12px; color: #64748b; padding: 12px 20px; border-bottom: 2px solid #f1f5f9; }
        td { padding: 10px 20px; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <aside class="w-64 h-full bg-white border-r flex flex-col p-6">
        <div class="mb-10">
            <h1 class="text-xl font-bold text-slate-800">DATA GRAPHIC</h1>
            <p class="text-[10px] text-orange-400 font-bold tracking-widest">WARROOM FIXED</p>
        </div>
        <nav class="space-y-1 flex-1">
            <button onclick="switchView('overview')" id="nav-overview" class="w-full text-left px-4 py-3 rounded-lg nav-active">ภาพรวม</button>
            <button onclick="switchView('orders')" id="nav-orders" class="w-full text-left px-4 py-3 rounded-lg text-slate-500">งานผลิต</button>
            <button onclick="switchView('fix')" id="nav-fix" class="w-full text-left px-4 py-3 rounded-lg text-slate-500">งานแก้</button>
        </nav>
    </aside>

    <main class="flex-1 p-8 overflow-y-auto">
        <div id="header-area" class="flex justify-between items-center mb-6">
            <h2 id="view-title" class="text-2xl font-bold text-slate-800">แดชบอร์ดสรุปผล</h2>
            <div id="status-indicator" class="text-xs text-green-500 font-bold">● Live Connection</div>
        </div>

        <div id="stats-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="card p-6">
                <p class="text-xs text-slate-400 font-bold uppercase">งานทั้งหมดวันนี้</p>
                <h4 id="stat-total" class="text-3xl font-black text-orange-500">0</h4>
            </div>
            <div class="card p-6">
                <p class="text-xs text-slate-400 font-bold uppercase">แผนกที่งานเยอะสุด</p>
                <h4 id="stat-busy-dept" class="text-xl font-bold text-slate-700">-</h4>
            </div>
        </div>

        <div id="overview-content" class="card p-6 h-96">
            <canvas id="mainChart"></canvas>
        </div>

        <div id="management-content" class="hidden space-y-6">
            <div class="card p-6">
                <form id="main-form" class="grid grid-cols-2 md:grid-cols-4 gap-4 items-end" onsubmit="handleFormSubmit(event)"></form>
            </div>
            <div class="card overflow-hidden">
                <table class="w-full text-left">
                    <thead><tr id="table-head"></tr></thead>
                    <tbody id="table-body"></tbody>
                </table>
            </div>
        </div>
    </main>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getFirestore, collection, onSnapshot, addDoc, updateDoc, deleteDoc, doc, query, limit } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";

        const firebaseConfig = {
            apiKey: "AIzaSyA0QWdvnA4ubJ42OAHxnDDJQUHkIFasu3w",
            authDomain: "data-5c343.firebaseapp.com",
            projectId: "data-5c343",
            storageBucket: "data-5c343.firebasestorage.app",
            messagingSenderId: "555799172632",
            appId: "1:555799172632:web:ced0d5f789362a9228156d"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);
        const appId = 'default-app-id';

        let rawData = { orders: [], fix: [] };
        let currentView = 'overview';
        let chartInstance = null;

        const CONFIG = {
            orders: { 
                cols: ['วันที่', 'เวลา', 'เลขที่งาน', 'จำนวน', 'แผนก', 'สถานะ'],
                fields: [
                    { name: 'date', label: 'วันที่', type: 'date' },
                    { name: 'time', label: 'เวลา', type: 'time' },
                    { name: 'jobId', label: 'เลขที่งาน', type: 'text' },
                    { name: 'count', label: 'จำนวน', type: 'number' },
                    { name: 'dept', label: 'แผนก', type: 'select', options: ['งานเรียง', 'งานล็อต', 'งานBY'] }
                ]
            },
            fix: { 
                cols: ['วันที่เวลา', 'รูปที่', 'ประเภท', 'SKU', 'สถานะ'],
                fields: [
                    { name: 'datetime', label: 'วันที่/เวลา', type: 'datetime-local' },
                    { name: 'photoNo', label: 'รูปที่', type: 'number' },
                    { name: 'type', label: 'ประเภท', type: 'select', options: ['ผิดลาย', 'ผิดสี', 'งานไม่ชัด'] },
                    { name: 'sku', label: 'SKU', type: 'text' }
                ]
            }
        };

        // 🛡️ Fix: One-time Anonymous Login
        signInAnonymously(auth).then(() => {
            initRealtimeSync();
        });

        // 🛡️ Fix: Single Listener per collection (Saves Quota)
        function initRealtimeSync() {
            ['orders', 'fix'].forEach(colName => {
                const q = query(collection(db, 'artifacts', appId, 'public', 'data', colName), limit(200));
                onSnapshot(q, (snapshot) => {
                    rawData[colName] = snapshot.docs.map(doc => ({
                        id: doc.id,
                        values: doc.data().data
                    }));
                    refreshUI();
                });
            });
        }

        function refreshUI() {
            updateStats();
            if (currentView === 'overview') renderChart();
            else renderTable();
        }

        async function handleFormSubmit(e) {
            e.preventDefault();
            const fd = new FormData(e.target);
            const data = CONFIG[currentView].fields.map(f => fd.get(f.name));
            data.push('กำลังทำ'); // Add initial status

            try {
                await addDoc(collection(db, 'artifacts', appId, 'public', 'data', currentView), {
                    data: data,
                    timestamp: new Date()
                });
                e.target.reset();
            } catch (err) { alert("เกิดข้อผิดพลาด: " + err.message); }
        }

        async function toggleStatus(firebaseId) {
            const item = rawData[currentView].find(x => x.id === firebaseId);
            const newData = [...item.values];
            const lastIdx = newData.length - 1;
            newData[lastIdx] = newData[lastIdx] === 'เสร็จแล้ว' ? 'กำลังทำ' : 'เสร็จแล้ว';
            
            await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', currentView, firebaseId), {
                data: newData
            });
        }

        function renderTable() {
            const head = document.getElementById('table-head');
            const body = document.getElementById('table-body');
            const config = CONFIG[currentView];

            head.innerHTML = config.cols.map(c => `<th>${c}</th>`).join('') + `<th>การจัดการ</th>`;
            body.innerHTML = rawData[currentView].map(item => `
                <tr>
                    ${item.values.map(v => `<td>${v}</td>`).join('')}
                    <td>
                        <button onclick="window.toggleStatus('${item.id}')" class="text-orange-500 font-bold mr-3">สลับสถานะ</button>
                    </td>
                </tr>
            `).join('');
        }

        function renderForm() {
            const form = document.getElementById('main-form');
            form.innerHTML = CONFIG[currentView].fields.map(f => `
                <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-bold text-slate-400 uppercase">${f.label}</label>
                    ${f.type === 'select' ? 
                        `<select name="${f.name}" class="p-2 border rounded-lg">${f.options.map(o => `<option value="${o}">${o}</option>`).join('')}</select>` :
                        `<input type="${f.type}" name="${f.name}" required class="p-2 border rounded-lg">`
                    }
                </div>
            `).join('') + `<button type="submit" class="bg-orange-500 text-white p-2 rounded-lg font-bold">บันทึก</button>`;
        }

        function updateStats() {
            const total = rawData.orders.length + rawData.fix.length;
            document.getElementById('stat-total').innerText = total;
            
            // หาแผนกที่งานเยอะที่สุด
            const depts = rawData.orders.map(o => o.values[4]);
            if(depts.length > 0) {
                const topDept = depts.sort((a,b) => depts.filter(v => v===a).length - depts.filter(v => v===b).length).pop();
                document.getElementById('stat-busy-dept').innerText = topDept || '-';
            }
        }

        function renderChart() {
            const ctx = document.getElementById('mainChart').getContext('2d');
            if (chartInstance) chartInstance.destroy();
            
            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['งานผลิต', 'งานแก้'],
                    datasets: [{
                        label: 'จำนวนงาน (รายการ)',
                        data: [rawData.orders.length, rawData.fix.length],
                        backgroundColor: ['#fb923c', '#38bdf8']
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }

        window.switchView = (v) => {
            currentView = v;
            document.querySelectorAll('nav button').forEach(b => b.classList.toggle('nav-active', b.id === `nav-${v}`));
            if (v === 'overview') {
                document.getElementById('overview-content').classList.remove('hidden');
                document.getElementById('management-content').classList.add('hidden');
                renderChart();
            } else {
                document.getElementById('overview-content').classList.add('hidden');
                document.getElementById('management-content').classList.remove('hidden');
                renderForm();
                renderTable();
            }
        };

        window.toggleStatus = toggleStatus;
    </script>
</body>
</html>
